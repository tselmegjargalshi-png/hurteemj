# ── Заавал шаардлагатай ────────────────────────────────────────────
# PostgreSQL холболтын мөр (Neon, Supabase, Vercel Postgres эсвэл өөрийн сервер)
DATABASE_URL=postgres://postgres@localhost:5432/hurteemj

# Сайтын бүрэн хаяг (CSRF/Origin шалгалт, холбоос үүсгэхэд)
APP_URL=http://localhost:3000

# ── Анхны администратор (зөвхөн `npm run db:create-admin` ажиллуулахад) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ── Холбогдоогүй үйлчилгээнүүд (хоосон бол туршилтын/идэвхгүй горимд) ──
# Төлбөр: QPay мерчантын эрх авсны дараа бөглөнө. Хоосон үед QPay сонголт харагдахгүй.
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_API_URL=https://merchant-sandbox.qpay.mn

# AI туслах: хоосон үед AI туслах "холбогдоогүй" гэж харагдана.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Газрын зураг: хоосон үед газрын зураг харуулахгүй, зөвхөн хаягаар.
MAPS_PROVIDER=
MAPS_API_KEY=
